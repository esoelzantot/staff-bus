{
  "name": "bus-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env scripts/seed.ts --dev",
    "reset-daily": "tsx --env-file=.env scripts/reset-daily.ts",
    "import-employees": "tsx --env-file=.env scripts/import-employees.ts",
    "create-user": "tsx --env-file=.env scripts/create-user.ts",
    "rules:deploy": "firebase deploy --only firestore",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "firebase-admin": "^12.6.0",
    "jspdf": "^2.5.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "tsx": "^4.19.1",
    "typescript": "~5.6.2",
    "vite": "^5.4.8"
  }
}

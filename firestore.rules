rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Staff Bus – Firestore Security Rules
//
// Identity : Firebase Auth UID  →  users/{uid}  { role, employeeDocId }
//            Sign-in goes through /api/login (custom token): Employee ID for employees, ID + PIN for
//            managers / admins – see README "Security model".
// Roles    : employee | manager | admin
//
// Capacity integrity
//   buses/{busId} keeps goingCount / returningCount (number of employees "in").
//   Every status change MUST be committed atomically (transaction / batch) with
//   the matching counter change. Both the employee rule and the bus rule
//   cross-check the delta with getAfter(), and the counter may never exceed
//   capacity. Because rules run against the live data at commit time, two
//   concurrent "join" requests at 12/13 cannot both succeed.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Path helpers ────────────────────────────────────────────────────────
    function userPath(uid)       { return /databases/$(database)/documents/users/$(uid); }
    function employeePath(empId) { return /databases/$(database)/documents/employees/$(empId); }
    function busPath(busId)      { return /databases/$(database)/documents/buses/$(busId); }

    // ── Identity helpers ────────────────────────────────────────────────────
    function hasProfile() { return request.auth != null && exists(userPath(request.auth.uid)); }
    function profile()    { return get(userPath(request.auth.uid)).data; }
    function isAdmin()    { return hasProfile() && profile().role == 'admin'; }
    function isManager()  { return hasProfile() && profile().role in ['manager', 'admin']; }
    function isEmployee() { return hasProfile() && profile().role == 'employee'; }
    function ownsEmployee(empId) { return isEmployee() && profile().employeeDocId == empId; }

    // Employees may READ everyone on their own bus (names + statuses), but only WRITE their own record.
    function myBusId()        { return get(employeePath(profile().employeeDocId)).data.busId; }
    function sameBus(busId)   { return isEmployee() && myBusId() == busId; }

    // 1 when the status is "in", otherwise 0 → used to compute counter deltas.
    function inDelta(before, after) {
      return (after == 'in' ? 1 : 0) - (before == 'in' ? 1 : 0);
    }

    // ── Trip day ────────────────────────────────────────────────────────────
    // A trip's "date" must be TODAY in Cairo (the service runs in Cairo, UTC+2 in winter / UTC+3 in summer),
    // judged by the server clock – a phone with a wrong date or time zone cannot create trips for other days.
    // Accepting both offsets only matters during the single hour around a daylight-saving change.
    function pad2(n)   { return n < 10 ? '0' + string(n) : string(n); }
    function dayKey(t) { return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day()); }
    function isCairoToday(date) {
      return date == dayKey(request.time + duration.value(2, 'h'))
          || date == dayKey(request.time + duration.value(3, 'h'));
    }

    // ── IN tally = number of DAYS the employee was IN (per direction) ──────
    // Going OUT → IN adds one day, IN → OUT takes it back (so IN, OUT, IN on the same day is still one day);
    // it never goes below zero. The second branch is the legacy behaviour of app versions that are still open on
    // some phones (+1 on OUT → IN, unchanged otherwise) – delete it once every client has been refreshed.
    function tallyOk(before, after, delta) {
      return after == ((before + delta) < 0 ? 0 : (before + delta))
          || after == before + (delta == 1 ? 1 : 0);
    }

    // ── Employee status change (used by the employee herself and by managers)
    function statusUpdateValid() {
      let before    = resource.data;
      let after     = request.resource.data;
      let busBefore = get(busPath(before.busId)).data;
      let busAfter  = getAfter(busPath(before.busId)).data;
      let dG        = inDelta(before.goingStatus, after.goingStatus);
      let dR        = inDelta(before.returningStatus, after.returningStatus);
      return after.diff(before).affectedKeys()
            .hasOnly(['goingStatus', 'returningStatus', 'goingInCount', 'returningInCount', 'updatedAt'])
        // IN tallies count days: +1 on OUT → IN, -1 on IN → OUT (see tallyOk)
        && tallyOk(before.get('goingInCount', 0), after.get('goingInCount', 0), dG)
        && tallyOk(before.get('returningInCount', 0), after.get('returningInCount', 0), dR)
        && after.goingStatus in ['in', 'out']
        && after.returningStatus in ['in', 'out']
        && after.updatedAt == request.time
        && busAfter.goingCount == busBefore.goingCount + dG
        && busAfter.returningCount == busBefore.returningCount + dR
        && (dG <= 0 || busAfter.goingCount <= busBefore.capacity)
        && (dR <= 0 || busAfter.returningCount <= busBefore.capacity);
    }

    // ── Daily IN record: employees/{employeeId}/attendance/{yyyy-mm-dd} ────
    // One document per person per Cairo day, kept in step with the employee's statuses by the client AFTER the
    // status change is committed (and created at midnight by the daily reset). It may only describe TODAY and must
    // equal the employee's current statuses, so the log can never claim something the statuses do not say.
    function attendanceValid(empId, day) {
      let d = request.resource.data;
      let e = get(employeePath(empId)).data;
      return d.keys().hasOnly(['date', 'goingStatus', 'returningStatus', 'updatedAt'])
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.date == day
        && isCairoToday(day)
        && d.goingStatus == e.goingStatus
        && d.returningStatus == e.returningStatus
        && d.updatedAt == request.time;
    }

    // ── Bus counter change made by an employee (must mirror her own status change)
    function employeeBusUpdateValid(busId) {
      let empPath = employeePath(profile().employeeDocId);
      let e0      = get(empPath).data;
      let e1      = getAfter(empPath).data;
      let b0      = resource.data;
      let b1      = request.resource.data;
      let dG      = inDelta(e0.goingStatus, e1.goingStatus);
      let dR      = inDelta(e0.returningStatus, e1.returningStatus);
      return e0.busId == busId
        && b1.diff(b0).affectedKeys().hasOnly(['goingCount', 'returningCount', 'updatedAt'])
        && b1.goingCount == b0.goingCount + dG
        && b1.returningCount == b0.returningCount + dR
        && b1.goingCount >= 0
        && b1.returningCount >= 0
        && (dG <= 0 || b1.goingCount <= b0.capacity)
        && (dR <= 0 || b1.returningCount <= b0.capacity);
    }

    // ── Manager edits on a bus (trip switch + counters through status changes)
    function managerBusUpdateValid() {
      let b0 = resource.data;
      let b1 = request.resource.data;
      return b1.diff(b0).affectedKeys().hasOnly(['activeTripType', 'goingCount', 'returningCount', 'updatedAt'])
        && b1.activeTripType in ['going', 'returning']
        && b1.goingCount >= 0 && b1.goingCount <= b0.capacity
        && b1.returningCount >= 0 && b1.returningCount <= b0.capacity;
    }

    // ── Trips
    // Employee "وصلنا": an employee on the bus may record the arrival of the GOING trip only.
    // Everything is cross-checked against her own employee record and the bus document, so nobody can
    // record it for another bus or for the returning direction, or sign it with someone else's name.
    // Case 1 – today's trip does not exist yet: create it already "arrived".
    function employeeTripCreateValid(tripId) {
      let d   = request.resource.data;
      let me  = get(employeePath(profile().employeeDocId)).data;
      let bus = get(busPath(me.busId)).data;
      return d.keys().hasOnly(['busId', 'route', 'busNumber', 'tripType', 'capacity', 'date', 'status',
                               'arrivalTime', 'arrivedById', 'arrivedByName', 'createdAt', 'updatedAt'])
        && d.busId == me.busId
        && d.route == bus.route
        && d.busNumber == bus.busNumber
        && d.capacity == bus.capacity
        && d.tripType == 'going'
        && d.date is string
        && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isCairoToday(d.date)
        && tripId == d.busId + '_' + d.date + '_' + d.tripType
        && d.status == 'arrived'
        && d.arrivalTime == request.time
        && d.arrivedById == profile().employeeDocId
        && d.arrivedByName == me.name
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    // Case 2 – the trip exists and has no arrival yet: record it once.
    function employeeTripArrivalValid() {
      let old = resource.data;
      let d   = request.resource.data;
      let me  = get(employeePath(profile().employeeDocId)).data;
      return old.busId == me.busId
        && old.arrivalTime == null
        && old.tripType == 'going'
        && d.diff(old).affectedKeys().hasOnly(['status', 'arrivalTime', 'arrivedById', 'arrivedByName', 'updatedAt'])
        && d.status == 'arrived'
        && d.arrivalTime == request.time
        && d.arrivedById == profile().employeeDocId
        && d.arrivedByName == me.name
        && d.updatedAt == request.time;
    }

    // Case 3 – cancel (the X): only the employee who recorded the arrival can undo it (managers/admins use their own rule).
    function employeeTripCancelValid() {
      let old = resource.data;
      let d   = request.resource.data;
      return old.get('arrivedById', null) == profile().employeeDocId
        && old.tripType == 'going'
        && d.diff(old).affectedKeys().hasOnly(['status', 'arrivalTime', 'arrivedById', 'arrivedByName', 'updatedAt'])
        && d.arrivalTime == null
        && d.status == 'active'
        && d.get('arrivedById', null) == null
        && d.get('arrivedByName', null) == null
        && d.updatedAt == request.time;
    }

    function tripCreateValid(tripId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['busId', 'route', 'busNumber', 'tripType', 'capacity', 'date',
                               'status', 'arrivalTime', 'createdAt', 'updatedAt'])
        && d.busId is string && exists(busPath(d.busId))
        && d.tripType in ['going', 'returning']
        && d.date is string
        && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isCairoToday(d.date)
        && tripId == d.busId + '_' + d.date + '_' + d.tripType
        && d.capacity is int && d.capacity > 0
        && d.status == 'active'
        && d.arrivalTime == null
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    function tripUpdateValid() {
      let old = resource.data;
      let d   = request.resource.data;
      return d.diff(old).affectedKeys().hasOnly(['status', 'arrivalTime', 'arrivedById', 'arrivedByName', 'updatedAt'])
        && d.updatedAt == request.time
        && (
          // record arrival – only once
          (old.arrivalTime == null && d.arrivalTime == request.time && d.status == 'arrived')
          // explicit reset (also clears who recorded it)
          || (d.arrivalTime == null && d.status == 'active'
              && d.get('arrivedById', null) == null && d.get('arrivedByName', null) == null)
        );
    }

    // ── Live bus location (busLocations/{busId}, one document per bus) ─────
    // One employee at a time shares her phone's position. A colleague may take over only when nobody is
    // sharing, when it is herself (resume), or when the last update is older than 90 s (phone died / offline).
    function locationFixValid(d) {
      return d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && (d.get('accuracy', null) == null || d.accuracy is number)
        && (d.get('speed', null) == null || d.speed is number)
        && (d.get('heading', null) == null || d.heading is number);
    }

    // Start / resume sharing: writes the whole document, signed with her own id and name.
    function locationClaimValid() {
      let d  = request.resource.data;
      let me = get(employeePath(profile().employeeDocId)).data;
      return d.keys().hasOnly(['active', 'lat', 'lng', 'accuracy', 'speed', 'heading',
                               'sharedById', 'sharedByName', 'startedAt', 'updatedAt'])
        && d.active == true
        && d.sharedById == profile().employeeDocId
        && d.sharedByName == me.name
        && locationFixValid(d)
        && d.startedAt == request.time
        && d.updatedAt == request.time;
    }

    function locationClaimAllowed() {
      let old = resource.data;
      return old.active == false
        || old.sharedById == profile().employeeDocId
        || request.time - old.updatedAt > duration.value(90, 's');
    }

    // New position from the current sharer only.
    function locationTickValid() {
      let old = resource.data;
      let d   = request.resource.data;
      return old.active == true
        && old.sharedById == profile().employeeDocId
        && d.diff(old).affectedKeys().hasOnly(['lat', 'lng', 'accuracy', 'speed', 'heading', 'updatedAt'])
        && locationFixValid(d)
        && d.updatedAt == request.time;
    }

    // Stop sharing: current sharer only.
    function locationStopValid() {
      let old = resource.data;
      let d   = request.resource.data;
      return old.sharedById == profile().employeeDocId
        && d.diff(old).affectedKeys().hasOnly(['active', 'updatedAt'])
        && d.active == false
        && d.updatedAt == request.time;
    }

    // ── Collections ─────────────────────────────────────────────────────────
    // Server-only collections (written / read exclusively by the Admin SDK in /api and scripts, which bypasses
    // these rules). Denied to every client – including admins – so PIN hashes and login counters never leak.
    //   credentials/{uid}      PIN hash of a manager / admin
    //   loginAttempts/{key}    failed-login counters (per IP and per privileged account)
    //   meta/{doc}             daily reset + hardening bookkeeping
    match /credentials/{id}   { allow read, write: if false; }
    match /loginAttempts/{id} { allow read, write: if false; }
    match /meta/{id}          { allow read, write: if false; }

    match /users/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isManager());
      allow write: if isAdmin();
    }

    match /employees/{empId} {
      allow get:    if isManager() || ownsEmployee(empId) || sameBus(resource.data.busId);
      // Queries must filter on busId == the caller's bus, otherwise they are rejected.
      allow list:   if isManager() || sameBus(resource.data.busId);
      allow create: if isAdmin()
                    && request.resource.data.employeeId == empId
                    && request.resource.data.type in ['main', 'waiting']
                    && request.resource.data.goingStatus == 'out'
                    && request.resource.data.returningStatus == 'out';
      allow delete: if isAdmin();
      allow update: if isAdmin()
                    || ((ownsEmployee(empId) || isManager()) && statusUpdateValid());
    }

    // The history is read by managers (PDF export) and by the employee herself; written only through the app
    // (today's record, mirroring the statuses) or by the Admin SDK (daily reset). Never edited or deleted by clients.
    match /employees/{empId}/attendance/{day} {
      allow read:   if isManager() || ownsEmployee(empId);
      allow create, update: if (isManager() || ownsEmployee(empId)) && attendanceValid(empId, day);
      allow delete: if false;
    }

    match /buses/{busId} {
      allow read:   if isManager() || sameBus(busId);
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
                    || (isManager() && managerBusUpdateValid())
                    || (isEmployee() && employeeBusUpdateValid(busId));
    }

    match /busLocations/{busId} {
      allow read:   if isManager() || sameBus(busId);
      allow create: if isEmployee() && sameBus(busId) && locationClaimValid();
      allow update: if isEmployee() && sameBus(busId)
                    && ((locationClaimValid() && locationClaimAllowed())
                        || locationTickValid()
                        || locationStopValid());
      allow delete: if isAdmin();
    }

    match /busTrips/{tripId} {
      // Employees read only trips of their own bus ("resource == null" = the trip is not created yet).
      allow read:   if isManager() || (isEmployee() && (resource == null || sameBus(resource.data.busId)));
      allow create: if (isManager() && tripCreateValid(tripId))
                    || (isEmployee() && employeeTripCreateValid(tripId));
      allow update: if isAdmin()
                    || (isManager() && tripUpdateValid())
                    || (isEmployee() && (employeeTripArrivalValid() || employeeTripCancelValid()));
      allow delete: if isAdmin();
    }
  }
}

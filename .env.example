# Firebase Web App config (Firebase console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: shown on the PDF header
VITE_COMPANY_NAME=
# Optional: synthetic e-mail domain used to map Employee IDs to Firebase Auth accounts.
# Must be identical for the web app and the provisioning scripts.
VITE_EMPLOYEE_EMAIL_DOMAIN=employees.busapp.local

# Optional: secret-ish suffix used to derive the Firebase Auth password from an Employee ID.
# Must be identical for the web app and the provisioning scripts. (It ships in the browser bundle.)
VITE_AUTH_SUFFIX=staff-bus-access

# Scripts only (seed / create-user): path to a service-account key JSON.
# NEVER commit this file and NEVER expose it to the browser.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

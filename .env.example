# Firebase Web App config (Firebase console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: shown on the PDF header
VITE_COMPANY_NAME=

# Synthetic e-mail domain that links an Employee ID to its Firebase Auth account. SERVER SIDE ONLY now
# (api/login.ts, api/employees.ts and the scripts) – the browser no longer builds any credential from an ID.
# Must be identical for the Vercel project and the scripts, and must not change once accounts exist.
VITE_EMPLOYEE_EMAIL_DOMAIN=employees.busapp.local

# Vercel only (Project -> Settings -> Environment Variables, NOT in this file): the serverless functions
# api/login.ts (sign-in) and api/employees.ts (manager "إدارة الموظفين") need
# FIREBASE_SERVICE_ACCOUNT = the whole service-account JSON.

# Scripts only (seed / create-user / set-pin / harden-auth): path to a service-account key JSON.
# NEVER commit this file and NEVER expose it to the browser.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Seed script only (development project): PIN given to the sample manager MGR001.
# SEED_MANAGER_PIN=
